# ==========================================
# Cyber Trade - Environment Configuration
# ==========================================

# 1. Telegram Bot Credentials
# BotFather orqali olingan token va xabarlar borishi kerak bo'lgan kanal/guruh ID si
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id
TELEGRAM_ADMIN_CHAT_ID=123456789,987654321

# 2. Conversational AI Assistant (Google Gemini + Groq Hybrid Architecture)
# Google AI Studio API kaliti: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_PRIMARY=gemini-3.8-flash
AI_MODEL_LITE=gemini-3.5-flash-lite
AI_MODEL_COMPLEX=gemini-3.1-pro-preview

# Groq 100% bepul ultra-tezkor LPU API kaliti: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# 3. Server & Loop Settings
POLL_INTERVAL_SECONDS=60
PRIMARY_TIMEFRAME=15m

# 4. MetaTrader 5 / Broker Direct Connection (XM, Exness, etc.)
MT5_ENABLED=true
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=XMGlobal-MT5 5
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=GOLD
